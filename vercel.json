{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run prepare:demo && npm run check",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/openbot-website/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/openbot-website/:path*", "destination": "/:path*" }
  ]
}
